# Copy to .env and adjust. Settings are read in one place: app/config.py
# Values below are planned defaults; variables are added as phases land.

DISTILL_DATABASE_URL=sqlite:///distill.db
DISTILL_STORAGE_DIR=./data
DISTILL_TIMEOUT=15
DISTILL_MAX_RESPONSE_BYTES=10485760
DISTILL_RESPECT_ROBOTS=true
DISTILL_USER_AGENT=Distill/1.0
